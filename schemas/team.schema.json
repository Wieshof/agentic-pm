{
  "$defs": {
    "Archetype": {
      "enum": [
        "reader",
        "writer",
        "talker",
        "listener"
      ],
      "title": "Archetype",
      "type": "string"
    },
    "Brief": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "anyOf": [
            {
              "pattern": "^(?:(?:daily|Mon|Tue|Wed|Thu|Fri|Sat|Sun) )?(?:[01]\\d|2[0-3]):[0-5]\\d$|^(?:first|last)_(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)(?: (?:[01]\\d|2[0-3]):[0-5]\\d)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Own time; default is cadence.morning_triage",
          "title": "When"
        },
        "format": {
          "$ref": "#/$defs/BriefFormat"
        }
      },
      "required": [
        "format"
      ],
      "title": "Brief",
      "type": "object"
    },
    "BriefFormat": {
      "enum": [
        "email",
        "chat",
        "voice"
      ],
      "title": "BriefFormat",
      "type": "string"
    },
    "Cadence": {
      "additionalProperties": false,
      "properties": {
        "morning_triage": {
          "anyOf": [
            {
              "pattern": "^(?:(?:daily|Mon|Tue|Wed|Thu|Fri|Sat|Sun) )?(?:[01]\\d|2[0-3]):[0-5]\\d$|^(?:first|last)_(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)(?: (?:[01]\\d|2[0-3]):[0-5]\\d)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Personal briefs for everyone without their own brief.when",
          "title": "Morning Triage"
        },
        "end_of_day": {
          "anyOf": [
            {
              "pattern": "^(?:(?:daily|Mon|Tue|Wed|Thu|Fri|Sat|Sun) )?(?:[01]\\d|2[0-3]):[0-5]\\d$|^(?:first|last)_(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)(?: (?:[01]\\d|2[0-3]):[0-5]\\d)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short evening note to leads, only if something needs them",
          "title": "End Of Day"
        },
        "weekly_digest": {
          "anyOf": [
            {
              "pattern": "^(?:(?:daily|Mon|Tue|Wed|Thu|Fri|Sat|Sun) )?(?:[01]\\d|2[0-3]):[0-5]\\d$|^(?:first|last)_(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)(?: (?:[01]\\d|2[0-3]):[0-5]\\d)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Week roll-up for leads (steering)",
          "title": "Weekly Digest"
        },
        "monthly_health_check": {
          "anyOf": [
            {
              "pattern": "^(?:(?:daily|Mon|Tue|Wed|Thu|Fri|Sat|Sun) )?(?:[01]\\d|2[0-3]):[0-5]\\d$|^(?:first|last)_(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)(?: (?:[01]\\d|2[0-3]):[0-5]\\d)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Monthly check against baseline (arrives with issue #54)",
          "title": "Monthly Health Check"
        },
        "inbox_poll_minutes": {
          "default": 2,
          "maximum": 60,
          "minimum": 1,
          "title": "Inbox Poll Minutes",
          "type": "integer"
        }
      },
      "title": "Cadence",
      "type": "object"
    },
    "Channels": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "anyOf": [
            {
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "phone": {
          "anyOf": [
            {
              "pattern": "^\\+[0-9 ]{6,20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "whatsapp": {
          "anyOf": [
            {
              "pattern": "^\\+[0-9 ]{6,20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Whatsapp"
        },
        "chat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slack/Teams handle",
          "title": "Chat"
        }
      },
      "title": "Channels",
      "type": "object"
    },
    "CheckIn": {
      "additionalProperties": false,
      "properties": {
        "window": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d-(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Window",
          "type": "string"
        },
        "max_call_seconds": {
          "default": 90,
          "maximum": 600,
          "minimum": 30,
          "title": "Max Call Seconds",
          "type": "integer"
        }
      },
      "required": [
        "window"
      ],
      "title": "CheckIn",
      "type": "object"
    },
    "Completeness": {
      "additionalProperties": false,
      "description": "Which details every open task should have (data completeness check).",
      "properties": {
        "require_owner": {
          "default": true,
          "title": "Require Owner",
          "type": "boolean"
        },
        "require_due": {
          "default": true,
          "title": "Require Due",
          "type": "boolean"
        },
        "require_estimate": {
          "default": false,
          "title": "Require Estimate",
          "type": "boolean"
        },
        "require_blocker_reason": {
          "default": true,
          "title": "Require Blocker Reason",
          "type": "boolean"
        },
        "detect_hints": {
          "default": true,
          "description": "Suggest links for 'waiting on #14' & co. in task text",
          "title": "Detect Hints",
          "type": "boolean"
        },
        "triage": {
          "description": "Who gets unowned tasks (default: project.leads)",
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "title": "Triage",
          "type": "array"
        },
        "max_per_brief": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Per Brief",
          "type": "integer"
        }
      },
      "title": "Completeness",
      "type": "object"
    },
    "Interruptions": {
      "enum": [
        "any",
        "urgent-only",
        "none"
      ],
      "title": "Interruptions",
      "type": "string"
    },
    "LLMSettings": {
      "additionalProperties": false,
      "description": "Model access; local-first per ADR-0001.",
      "properties": {
        "provider": {
          "default": "openai-compatible",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "default": "llama3.1:8b",
          "title": "Model",
          "type": "string"
        },
        "base_url": {
          "default": "http://localhost:11434/v1",
          "title": "Base Url",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        }
      },
      "title": "LLMSettings",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "archetype": {
          "$ref": "#/$defs/Archetype"
        },
        "channels": {
          "$ref": "#/$defs/Channels"
        },
        "brief": {
          "anyOf": [
            {
              "$ref": "#/$defs/Brief"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "check_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckIn"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interruptions": {
          "$ref": "#/$defs/Interruptions",
          "default": "any"
        },
        "quiet_hours": {
          "anyOf": [
            {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d-(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quiet Hours"
        },
        "escalate_after_ignored": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Escalate After Ignored",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the agent greets this person",
          "title": "Name"
        },
        "language": {
          "default": "en",
          "description": "Language the agent uses with this person (briefs, calls, chats)",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "title": "Language",
          "type": "string"
        },
        "tracker_login": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Username in the tracker if it differs from the handle (GitHub login, or OpenProject display name)",
          "title": "Tracker Login"
        }
      },
      "required": [
        "role",
        "archetype",
        "channels"
      ],
      "title": "Person",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "tracker": {
          "description": "Tracker key from the catalog (`agent-pm trackers`), e.g. github, jira, or an installed plugin",
          "title": "Tracker",
          "type": "string"
        },
        "repo": {
          "description": "GitHub 'owner/repo', or OpenProject project identifier",
          "title": "Repo",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tracker URL, required for self-hosted trackers (OpenProject)",
          "title": "Base Url"
        },
        "tracker_options": {
          "additionalProperties": true,
          "description": "Tracker-specific mapping, e.g. status_map for Trello lists or property names for Notion databases (never secrets)",
          "title": "Tracker Options",
          "type": "object"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        },
        "leads": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Leads",
          "type": "array"
        },
        "brief_horizon_days": {
          "default": 3,
          "description": "'Due soon' window used in briefs",
          "maximum": 14,
          "minimum": 1,
          "title": "Brief Horizon Days",
          "type": "integer"
        },
        "ticket_language": {
          "default": "en",
          "description": "Language the agent writes in the tracker (how-to docs, comments), independent of the language people speak with it",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "title": "Ticket Language",
          "type": "string"
        },
        "allow_writes": {
          "default": false,
          "description": "Opt-in: let the agent write to the tracker (comments, labels, fields), always behind the permission tiers",
          "title": "Allow Writes",
          "type": "boolean"
        },
        "agent_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The agent's mailbox, e.g. pm@acme.com. Replies about a task go to plus-addresses like pm+142@acme.com",
          "title": "Agent Email"
        },
        "control_plane_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public URL of `agent-pm run` (approval links, webhooks), e.g. https://pm.acme.com",
          "title": "Control Plane Url"
        },
        "agent_accounts": {
          "description": "Tracker logins the agent writes with (service accounts). Webhooks caused by these accounts are ignored to prevent self-triggering loops.",
          "items": {
            "type": "string"
          },
          "title": "Agent Accounts",
          "type": "array"
        }
      },
      "required": [
        "tracker",
        "repo",
        "leads"
      ],
      "title": "Project",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project": {
      "$ref": "#/$defs/Project"
    },
    "people": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._-]*$": {
          "$ref": "#/$defs/Person"
        }
      },
      "title": "People",
      "type": "object"
    },
    "llm": {
      "$ref": "#/$defs/LLMSettings",
      "default": {
        "provider": "openai-compatible",
        "model": "llama3.1:8b",
        "base_url": "http://localhost:11434/v1",
        "reasoning_effort": null
      }
    },
    "cadence": {
      "$ref": "#/$defs/Cadence",
      "default": {
        "morning_triage": null,
        "end_of_day": null,
        "weekly_digest": null,
        "monthly_health_check": null,
        "inbox_poll_minutes": 2
      }
    },
    "completeness": {
      "$ref": "#/$defs/Completeness",
      "default": {
        "require_owner": true,
        "require_due": true,
        "require_estimate": false,
        "require_blocker_reason": true,
        "detect_hints": true,
        "triage": [],
        "max_per_brief": 5
      }
    }
  },
  "required": [
    "project",
    "people"
  ],
  "title": "agentic-pm team.yaml",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
